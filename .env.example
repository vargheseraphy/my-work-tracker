# Copy to .env (the build does this). Never commit .env.

NODE_ENV=development
APP_URL=http://localhost:5173
PORT=3000

# --- database ---
# Owner role: migrations only. Locally this matches docker-compose.yml.
DATABASE_URL_OWNER=postgres://gtm_owner:gtm_owner_local_only@localhost:5432/gtm
DATABASE_URL_OWNER_TEST=postgres://gtm_owner:gtm_owner_local_only@localhost:5432/gtm_test
# App role: what the server uses. Phase 0 generates one password, sets it with ALTER ROLE,
# and writes the same value in all three places below (no variable expansion in .env).
GTM_APP_PASSWORD=change-me
DATABASE_URL=postgres://gtm_app:change-me@localhost:5432/gtm
DATABASE_URL_TEST=postgres://gtm_app:change-me@localhost:5432/gtm_test

# --- sessions ---
SESSION_SECRET=change-me-64-hex-chars
SESSION_IDLE_HOURS=12
SESSION_MAX_DAYS=7

# --- files ---
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=5242880

# --- email ---
# Local default: Mailpit catches everything at http://localhost:8025. Nobody receives anything.
# For real email, see docs/EMAIL.md and replace these five values.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Yallo GTM <gtm-tracker@localhost>"

# --- jobs ---
JOBS_ENABLED=true
REMINDER_CRON="*/15 * * * *"
REPORT_CRON="0 9 * * 1"
REPORT_TIMEZONE=Asia/Kolkata

# --- invites ---
ALLOWED_EMAIL_DOMAINS=yallo.co
INVITE_TOKEN_HOURS=48
